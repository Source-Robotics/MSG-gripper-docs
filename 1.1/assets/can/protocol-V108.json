    {
      "key": "IN_WATCHDOG_TIMEOUT",
      "id": 15,
      "name": "Send_Watchdog",
      "description": "Sets the watchdog: every valid CAN frame the driver receives resets it; when the time runs out the driver reports a watchdog error and stops. 0 turns it off (the default). The action byte is stored but not acted on by this firmware: the driver always stops into its idle behaviour.",
      "forms": [
        {
          "direction": "host",
          "length": 5,
          "remote": false,
          "title": "command",
          "fields": [
            {
              "name": "Time",
              "byte": 0,
              "size": 4,
              "bits": null,
              "width": 32,
              "signed": false,
              "float": false,
              "lsb_first": false,
              "meaning": "ms; 0 = off"
            },
            {
              "name": "Action",
              "byte": 4,
              "size": 1,
              "bits": null,
              "width": 8,
              "signed": false,
              "float": false,
              "lsb_first": false,
              "meaning": "0 idle, 1 hold, 2 brake (stored only)"
            }
          ]
        }
      ]
    },
