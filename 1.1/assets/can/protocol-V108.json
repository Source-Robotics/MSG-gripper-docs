      "key": "IN_CAN_ID",
      "id": 11,
      "name": "Send_CAN_ID",
      "description": "Gives the driver a new node ID, 0 to 13 (the firmware accepts up to 15, but the bootloader reserves 14 and 15: a driver on one of those cannot be updated over CAN). Setting the ID also sets the bootloader's board ID. The driver answers to the new ID at once; the ID is kept over a power cycle only after Send_Save_config.",
      "forms": [
        {
          "direction": "host",
          "length": 1,
          "remote": false,
          "title": "command",
          "fields": [
            {
              "name": "ID",
              "byte": 0,
              "size": 1,
              "bits": null,
              "width": 8,
              "signed": false,
              "float": false,
              "lsb_first": false,
              "meaning": "0 to 15"
            }
          ]
        }
      ]
    },
    {
      "key": "IN_ESTOP",
